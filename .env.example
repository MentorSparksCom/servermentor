# Authentication
# See docs/auth-proxy.md for Nginx, Traefik, and oauth2-proxy deployment examples.
AUTH_PROVIDERS=mentorlogin,github
AUTH_MODE=
AUTH_SESSION_SECRET=change-me-to-a-long-random-secret
AUTH_SESSION_TTL=8h
AUTH_SECURE_COOKIES=false
AUTH_ADMIN_EMAILS=admin@example.com
AUTH_ADMIN_GROUPS=
AUTH_REQUIRED_DOMAIN=
AUTH_GITHUB_ALLOWED_ORGS=
AUTH_GITHUB_ALLOWED_TEAMS=

# Proxy or header auth
# AUTH_MODE=proxy requires proxy headers and disables built-in login providers.
# AUTH_PROXY_ENABLED=true keeps AUTH_PROVIDERS active and also accepts trusted proxy headers.
AUTH_PROXY_ENABLED=false
AUTH_PROXY_DISPLAY_NAME=Single Sign-On
AUTH_PROXY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
AUTH_PROXY_TRUST_ALL=false
AUTH_PROXY_SUBJECT_HEADERS=X-Forwarded-User,X-Auth-Request-User,Remote-User
AUTH_PROXY_EMAIL_HEADERS=X-Forwarded-Email,X-Auth-Request-Email,Remote-Email
AUTH_PROXY_NAME_HEADERS=X-Forwarded-Preferred-Username,X-Forwarded-Name,X-Auth-Request-Preferred-Username
AUTH_PROXY_GROUPS_HEADERS=X-Forwarded-Groups,X-Auth-Request-Groups
AUTH_PROXY_ORGS_HEADERS=X-Forwarded-Orgs
AUTH_PROXY_TEAMS_HEADERS=X-Forwarded-Teams

# MentorLogin
AUTH_PROVIDER_MENTORLOGIN_CLIENT_ID=.
AUTH_PROVIDER_MENTORLOGIN_CLIENT_SECRET=.
AUTH_PROVIDER_MENTORLOGIN_CALLBACK_URL=http://localhost:8080/login/oauth2/code/mentorlogin
AUTH_PROVIDER_MENTORLOGIN_ISSUER=https://login.mentorsparks.com
AUTH_PROVIDER_MENTORLOGIN_EMAIL_CLAIM=email
AUTH_PROVIDER_MENTORLOGIN_GROUPS_CLAIM=groups

# GitHub
AUTH_PROVIDER_GITHUB_CLIENT_ID=.
AUTH_PROVIDER_GITHUB_CLIENT_SECRET=.
AUTH_PROVIDER_GITHUB_CALLBACK_URL=http://localhost:8080/auth/github/callback
AUTH_PROVIDER_GITHUB_SCOPES=read:user,user:email

# Runtime
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=servicetracker
PORT=8080